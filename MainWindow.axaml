<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        WindowState="Maximized"
        x:Class="ProyectoBD2.MainWindow"
        Title="ProyectoBD2">
    <Grid RowDefinitions="100,*">
        <Border Grid.Row="0" Background="#0078D4" BoxShadow="0 2 10 0 #40000000">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
                        <Button x:Name="DashboardButton" Classes="NavButton" Background="Transparent"
                                Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path
                                        Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M17,12H12V7H17V12M17,16H12V14H17V16M8,15V17H6V15H8M8,11V13H6V11H8M8,7V9H6V7H8Z"
                                        Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Citas" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ClientsButton" Classes="NavButton" Background="Transparent" Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path
                                        Data="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"
                                        Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Clientes" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="HostingButton" Classes="NavButton" Background="Transparent" Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"
                                          Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Hospedaje" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="PurchasesButton" Classes="NavButton" Background="Transparent" Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path Data="M2.5 4.25C2.5 3.83579 2.83579 3.5 3.25 3.5H3.80826C4.75873 3.5 5.32782 4.13899 5.65325 4.73299C5.87016 5.12894 6.02708 5.58818 6.14982 6.00395C6.18306 6.00134 6.21674 6 6.2508 6H18.7481C19.5783 6 20.1778 6.79442 19.9502 7.5928L18.1224 14.0019C17.7856 15.1832 16.7062 15.9978 15.4779 15.9978H9.52977C8.29128 15.9978 7.2056 15.1699 6.87783 13.9756L6.11734 11.2045L4.85874 6.95578L4.8567 6.94834C4.701 6.38051 4.55487 5.85005 4.33773 5.4537C4.12686 5.0688 3.95877 5 3.80826 5H3.25C2.83579 5 2.5 4.66421 2.5 4.25ZM7.57283 10.8403L8.32434 13.5786C8.47333 14.1215 8.96682 14.4978 9.52977 14.4978H15.4779C16.0362 14.4978 16.5268 14.1275 16.68 13.5906L18.4168 7.5H6.58549L7.55906 10.7868C7.56434 10.8046 7.56892 10.8224 7.57283 10.8403Z M11 19C11 20.1046 10.1046 21 9 21C7.89543 21 7 20.1046 7 19C7 17.8954 7.89543 17 9 17C10.1046 17 11 17.8954 11 19ZM9.5 19C9.5 18.7239 9.27614 18.5 9 18.5C8.72386 18.5 8.5 18.7239 8.5 19C8.5 19.2761 8.72386 19.5 9 19.5C9.27614 19.5 9.5 19.2761 9.5 19Z M18 19C18 20.1046 17.1046 21 16 21C14.8954 21 14 20.1046 14 19C14 17.8954 14.8954 17 16 17C17.1046 17 18 17.8954 18 19ZM16.5 19C16.5 18.7239 16.2761 18.5 16 18.5C15.7239 18.5 15.5 18.7239 15.5 19C15.5 19.2761 15.7239 19.5 16 19.5C16.2761 19.5 16.5 19.2761 16.5 19Z"
                                          Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Compras" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                        
                        <Button x:Name="EmpleadosButton" Classes="NavButton" Background="Transparent" Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path Data="M15.25 12.25C15.25 11.2835 14.4665 10.5 13.5 10.5H7.5C6.5335 10.5 5.75 11.2835 5.75 12.25V12.75C5.75 13.8289 6.26536 14.4053 7.12603 14.9505C7.97516 15.4884 9.15255 15.75 10.5 15.75C12.0888 15.75 13.2749 15.4915 14.0693 14.9453C14.8824 14.3863 15.25 13.8012 15.25 12.75V12.25ZM7.25 12.25C7.25 12.1119 7.36193 12 7.5 12H13.5C13.6381 12 13.75 12.1119 13.75 12.25V12.75C13.75 13.0164 13.7154 13.0786 13.6479 13.2C13.6309 13.2305 13.6118 13.2649 13.5906 13.3072C13.4871 13.5142 13.3266 13.6846 13.0878 13.8227C12.5953 14.1074 11.779 14.25 10.5 14.25C9.48116 14.25 8.6537 14.1102 8.08981 13.8173C7.81113 13.6725 7.60366 13.4939 7.46536 13.2822C7.43323 13.2331 7.40434 13.1951 7.37894 13.1617C7.29577 13.0522 7.25 12.992 7.25 12.75V12.25Z M13 7.5C13 8.88071 11.8807 10 10.5 10C9.11929 10 8 8.88071 8 7.5C8 6.11929 9.11929 5 10.5 5C11.8807 5 13 6.11929 13 7.5ZM11.5 7.5C11.5 6.94772 11.0523 6.5 10.5 6.5C9.94772 6.5 9.5 6.94772 9.5 7.5C9.5 8.05228 9.94772 8.5 10.5 8.5C11.0523 8.5 11.5 8.05228 11.5 7.5Z M3 6.25C3 4.45507 4.45507 3 6.25 3H14.75C16.5449 3 18 4.45507 18 6.25V14.75C18 16.5449 16.5449 18 14.75 18H6.25C4.45507 18 3 16.5449 3 14.75V6.25ZM6.25 4.5C5.2835 4.5 4.5 5.2835 4.5 6.25V14.75C4.5 15.7165 5.2835 16.5 6.25 16.5H14.75C15.7165 16.5 16.5 15.7165 16.5 14.75V6.25C16.5 5.2835 15.7165 4.5 14.75 4.5H6.25Z M8.74999 20.5C7.59938 20.5 6.58843 19.902 6.01089 19H15.25C17.3211 19 19 17.321 19 15.25V6.01086C19.9021 6.5884 20.5 7.59935 20.5 8.74996V15.25C20.5 18.1494 18.1495 20.5 15.25 20.5H8.74999Z"
                                          Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Empleados" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ReportsButton" Classes="NavButton" Background="Transparent" Foreground="White">
                            <StackPanel>
                                <Viewbox Width="40" Height="40">
                                    <Path
                                        Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M9,18H7V10H9V18M13,18H11V6H13V18M17,18H15V14H17V18Z"
                                        Fill="White" />
                                </Viewbox>
                                <TextBlock Text="Reportes" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="LogoutButton"
                        Classes="NavButton"
                        Background="Transparent"
                        Foreground="White"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,0">
                    <StackPanel>
                        <Viewbox Width="40" Height="40">
                            <Path
                                Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"
                                Fill="White" />
                        </Viewbox>
                        <TextBlock Text="Cerrar Sesión" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Row="1"></ContentControl>
    </Grid>
</Window>